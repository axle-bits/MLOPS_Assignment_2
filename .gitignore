# DVC-tracked data/models — DVC manages its own nested .gitignore entries for
# the actual tracked content (data/raw/.gitignore, data/.gitignore); only the
# .dvc pointer files and dvc.yaml/dvc.lock are tracked by git.
models/*.pt
!models/.gitkeep

mlruns/
mlartifacts/
results/*
!results/.gitkeep
logs/*
!logs/.gitkeep

.env
*.egg-info/
.pytest_cache/
.coverage
confusion_matrix.png

