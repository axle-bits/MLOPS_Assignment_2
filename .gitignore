__pycache__/
*.pyc
.venv/
venv/
env/

# DVC-tracked datasets — DVC manages its own nested .gitignore entries for the
# actual tracked content (data/raw/.gitignore, data/.gitignore); only the .dvc
# pointer files and dvc.yaml/dvc.lock are tracked by git.
#
# models/model.pt is deliberately NOT in this list: the trained weights are
# committed to git and baked into the Docker image, so the published image is
# self-contained and runs anywhere without a host bind mount.

mlruns/
mlartifacts/
# Post-deployment evaluation output is committed as evidence for M5; only
# ad-hoc extra runs are ignored.
results/*
!results/evaluation.csv
!results/evaluation_summary.json

.env
*.egg-info/
.pytest_cache/
.coverage
confusion_matrix.png

# Assignment materials that live in this same directory but aren't part of the
# submission repo itself
dog-and-cat-classification-dataset/
Assignment 2.pdf

# Editable report source. The exported REPORT.pdf is committed; the .docx is not.
REPORT.docx
